{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anime1-crawler-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "GITHUB_OWNER": "jacktdry",
    "GITHUB_REPO": "anime1_crawler",
    "GITHUB_WORKFLOW": "anime_crawler.yml",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
